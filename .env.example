# Nayooscore — Variables d'environnement
# Copiez ce fichier vers .env.local (jamais commité — voir .gitignore)

# InsForge (obligatoire)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_anon_key_here

# InsForge — clé service (serveur uniquement, JAMAIS côté client)
INSFORGE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sécurité — activer la vérification email dans le dashboard InsForge
# Auth > Settings > Require email verification
